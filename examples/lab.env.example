# Copy to ~/lab.env on each Linux VM and edit addresses and interface names.
export PROJECT_SOURCE="$HOME/oai-free5gc-n2-handover"
export FREE5GC_COMPOSE="$HOME/free5gc-compose"
export OAI_ROOT="$HOME/openairinterface5g"
export OAI_BUILD="$OAI_ROOT/cmake_targets/ran_build/build"
export IUF_ROOT="$PROJECT_SOURCE/iuf"
export CORE_VM_IP="192.168.192.145"
export EDGE1_VM_IP="192.168.192.140"
export EDGE2_VM_IP="192.168.192.141"
export UPF1_IP="192.168.192.240"
export UPF2_IP="192.168.192.241"
export UE_VM_IP="192.168.192.146"
export IUF_VM_IP="192.168.192.147"
export EDGE_IF="ens33"
export N6_IF="ens33"
export LAB_PREFIX="24"
export UE_CIDR="10.0.0.0/24"
